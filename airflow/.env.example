# ============================================================
# airflow/.env.example
# Copie ce fichier en .env (qui est gitignoré) puis adapte les valeurs.
#
# CE FICHIER EST UN MODÈLE PUBLIC. Le vrai .env (avec tes valeurs) est gitignoré.
# Convention : on n'expose JAMAIS les valeurs réelles dans le repo, seulement
# les NOMS de variables.
# ============================================================

# --- Airflow / Docker ---
# UID Linux/WSL : `echo "AIRFLOW_UID=$(id -u)" > .env`
AIRFLOW_UID=50000

# --- GCP (depuis console GCP) ---
# Project ID GCP (visible dans la console > Accueil), ex. "validatrade-438113"
GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
# Nom du fichier de clé service account (placé dans ~/.gcp/ sur ton host)
GCP_KEY_FILENAME=YOUR_SA_KEY_FILENAME.json

# --- Stockage ValidaTrade ---
# Nom du bucket GCS (créé en Phase 2)
VALIDATRADE_GCS_BUCKET=validatrade-raw
# Dataset BigQuery cible des modèles dbt (optionnel, défaut = validatrade_marts)
# VALIDATRADE_BQ_DATASET=validatrade_marts
